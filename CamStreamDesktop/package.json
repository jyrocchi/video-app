{
  "name": "jyrocam-desktop",
  "version": "1.0.5",
  "description": "JyroCam: visor, grabador y camara virtual",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/virtual-cam-color.js && node test/image-adjustments.js && node test/ndi-retry.js && node test/decoder-resolution.js && node test/stream-integration.js && node test/stream-integration.js 720p60 && node test/stream-integration.js 1080p30",
    "build": "electron-builder --win portable --x64",
    "pack": "electron-builder --dir --win --x64"
  },
  "author": "JyroCam",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.1.0",
    "jpeg-js": "^0.4.4",
    "koffi": "^2.10.0"
  },
  "build": {
    "appId": "com.anomaly.camstream.desktop",
    "productName": "JyroCam",
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "virtual-cam/bin/JyroCamVirtualCam.dll"
    ],
    "files": [
      "main.js",
      "preload.js",
      "viewer.html",
      "styles.css",
      "build-assets/jyrocam.ico",
      "ndi-sender.js",
      "h264-decoder.js",
      "stream-profiles.js",
      "image-adjustments.js",
      "virtual-cam-writer.js",
      "virtual-cam/bin/JyroCamVirtualCam.dll",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build-assets/jyrocam.ico",
      "target": "portable",
      "signAndEditExecutable": false,
      "artifactName": "JyroCam-Portable-${version}.exe"
    },
    "portable": {
      "artifactName": "JyroCam-Portable-${version}.exe"
    }
  }
}
